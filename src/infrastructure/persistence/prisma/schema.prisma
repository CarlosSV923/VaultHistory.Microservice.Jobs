// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  fullname           String
  email              String    @unique
  birthDate          DateTime? @db.Timestamptz(3)
  notification       Boolean   @default(false)
  notificationStatus String?
  notificationDate   DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @db.Timestamptz(3)
  updatedAt          DateTime? @db.Timestamptz(3)
  isActive           Boolean   @default(true)
  theme              String?
  character          String?
  passwordHash       String
  passwordSalt       String

  @@map("users")
}

model Outbox {
  id         String    @id @default(uuid()) @db.Uuid
  type       String
  payload    String
  occurredOn DateTime  @db.Timestamptz(3)
  status     String?   @default("PENDING")
  updateAt   DateTime? @db.Timestamptz(3)
  error      String?

  @@map("outbox_messages")
}
